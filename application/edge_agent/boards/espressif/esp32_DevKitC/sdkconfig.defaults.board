# sdkconfig overrides for ESP32-DevKitC (classic ESP32, 4MB flash, NO PSRAM)
#
# ── CPU & Flash ────────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ── Partition table ────────────────────────────────────────────────────────────
# Override the default 8MB partition table with the 4MB-compatible one.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"

# ── PSRAM / SPIRAM – DISABLED ──────────────────────────────────────────────────
# Classic ESP32-DevKitC has no PSRAM. All SPIRAM options must be off.
CONFIG_SPIRAM=n

# ── Memory tuning (internal RAM only) ─────────────────────────────────────────
# Reduce buffer counts to fit in the ~320 KB of internal DRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=8
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n

# ── Disable PSRAM-dependent stack placement ────────────────────────────────────
# CLAW_TASK_STACK_PREFER_PSRAM gracefully falls back to internal RAM when
# PSRAM is absent, so no source changes are required.

# ── LCD Lua module – disable by default (no display on plain DevKitC) ─────────
CONFIG_APP_CLAW_LUA_MODULE_LCD=n
