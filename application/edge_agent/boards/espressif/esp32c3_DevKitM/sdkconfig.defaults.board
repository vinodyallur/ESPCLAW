# sdkconfig overrides for ESP32-C3-DevKitM-1 (RISC-V, 4MB flash, NO PSRAM)
#
# ── CPU & Flash ────────────────────────────────────────────────────────────────
# ESP32-C3 has a single RISC-V core running up to 160 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# ── Partition table ────────────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"

# ── PSRAM / SPIRAM – DISABLED ──────────────────────────────────────────────────
CONFIG_SPIRAM=n

# ── Memory tuning (internal RAM only, ~400 KB on C3) ──────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=8
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n

# ── LCD Lua module – disable (no display on plain DevKitM) ────────────────────
CONFIG_APP_CLAW_LUA_MODULE_LCD=n
